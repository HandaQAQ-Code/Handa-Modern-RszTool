<ui:FluentWindow x:Class="RszTool.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:RszTool.App"
        xmlns:views="clr-namespace:RszTool.App.Views"
        xmlns:viewmodels="clr-namespace:RszTool.App.ViewModels"
        xmlns:res="clr-namespace:RszTool.App.Resources"
        xmlns:rsztool="clr-namespace:RszTool;assembly=RszTool"
        xmlns:dragablz="clr-namespace:Dragablz;assembly=Dragablz"
        xmlns:dockablz="clr-namespace:Dragablz.Dockablz;assembly=Dragablz"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=viewmodels:MainWindowModel}"
        Title="RE4R Retool &amp; ID-Flag Tuned Editor"
        Height="960" Width="1440" MinWidth="850" MinHeight="500"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        WindowStartupLocation="CenterScreen"
        FontSize="{Binding AppFontSize, FallbackValue=13}"
        AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop">

    <ui:FluentWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Dragablz;component/Themes/Generic.xaml" />
                <ResourceDictionary Source="Views/TreeViewStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <DataTemplate DataType="{x:Type dragablz:HeaderedItemViewModel}">
                <ContentControl Content="{Binding Content}" Margin="4" FontSize="{Binding (TextElement.FontSize), RelativeSource={RelativeSource AncestorType=Window}}" />
            </DataTemplate>

            <dragablz:DragablzIcon Width="18" Height="18" Margin="0,-2,4,0"
                                   x:Key="WindowIcon" x:Shared="False" />

            <!-- Modern Fluent Dragablz Tab Item Style (Clean Windows 11 Tabs, No Trapezoids) -->
            <Style TargetType="{x:Type dragablz:DragablzItem}" x:Key="FluentDragableTabItemStyle">
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="1,1,1,0"/>
                <Setter Property="Margin" Value="2,2,2,0"/>
                <Setter Property="Padding" Value="10,6,8,6"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type dragablz:DragablzItem}">
                            <Border x:Name="TabBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6,6,0,0"
                                    SnapsToDevicePixels="True">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Tab Header Content & Drag Thumb -->
                                    <ContentPresenter x:Name="ContentSite"
                                                      Grid.Column="0"
                                                      Content="{TemplateBinding ContentControl.Content}"
                                                      ContentStringFormat="{TemplateBinding ContentControl.ContentStringFormat}"
                                                      ContentTemplate="{TemplateBinding ContentControl.ContentTemplate}"
                                                      HorizontalAlignment="{TemplateBinding Control.HorizontalContentAlignment}"
                                                      VerticalAlignment="{TemplateBinding Control.VerticalContentAlignment}"
                                                      Margin="4,0,8,0" />

                                    <Thumb x:Name="PART_Thumb" Grid.Column="0">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="Transparent" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>

                                    <!-- Modern Tab Close Button -->
                                    <Button x:Name="CloseButton"
                                            Grid.Column="1"
                                            Command="{x:Static dragablz:TabablzControl.CloseItemCommand}"
                                            CommandParameter="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                            Width="18" Height="18"
                                            Padding="0"
                                            Margin="2,0,0,0"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            ToolTip="关闭标签 (Ctrl+W)">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="CloseBorder" CornerRadius="3" Background="Transparent">
                                                    <ui:SymbolIcon Symbol="Dismiss12" FontSize="9"
                                                                   Foreground="{DynamicResource TextForeground}"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="CloseBorder" Property="Background" Value="#33E81123"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}"/>
                                    <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Modern Dragablz Tab Control Style -->
            <Style TargetType="{x:Type dragablz:TabablzControl}" x:Key="TabablzControlStyle">
                <Setter Property="ItemsSource" Value="{Binding Items}" />
                <Setter Property="SelectedItem" Value="{Binding SelectedTabItem}" />
                <Setter Property="ClosingItemCallback" Value="{Binding ClosingTabItemHandler}" />
                <Setter Property="ShowDefaultAddButton" Value="False" />
                <Setter Property="ShowDefaultCloseButton" Value="False" />
                <Setter Property="AdjacentHeaderItemOffset" Value="0" />
                <Setter Property="ItemContainerStyle" Value="{StaticResource FluentDragableTabItemStyle}" />
                <Setter Property="HeaderMemberPath" Value="Header" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=(dockablz:Layout.IsTopLeftItem)}" Value="True">
                        <Setter Property="HeaderPrefixContent" Value="{StaticResource WindowIcon}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style TargetType="StackPanel" x:Key="UsageHint">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Items.Count}" Value="0">
                        <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </ui:FluentWindow.Resources>

    <ui:FluentWindow.InputBindings>
        <KeyBinding Command="{Binding OpenCommand}" Modifiers="Control" Key="O" />
        <KeyBinding Command="{Binding SaveCommand}" Modifiers="Control" Key="S" />
        <KeyBinding Command="{Binding SaveAsCommand}" Modifiers="Control+Shift" Key="S" />
        <KeyBinding Command="{Binding ReopenCommand}" Modifiers="Control" Key="R" />
        <KeyBinding Command="{Binding AddFolderCommand}" Modifiers="Control+Shift" Key="O" />
        <KeyBinding Command="{Binding CloseCommand}" Modifiers="Control" Key="W" />
        <KeyBinding Command="{Binding QuitCommand}" Modifiers="Control" Key="Q" />
    </ui:FluentWindow.InputBindings>

    <ui:FluentWindow.DataContext>
        <viewmodels:MainWindowModel />
    </ui:FluentWindow.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- TitleBar -->
            <RowDefinition Height="Auto"/> <!-- Unified Modern Command & Ribbon Bar -->
            <RowDefinition Height="*"/>    <!-- Main Work Area -->
        </Grid.RowDefinitions>

        <!-- Modern Fluent TitleBar -->
        <ui:TitleBar Grid.Row="0"
                     Title="RE4R Retool &amp; ID-Flag Tuned Editor"
                     Padding="12,4,12,4" />

        <!-- Modern Command & Navigation Ribbon -->
        <Border Grid.Row="1"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1"
                Padding="10,6">
            <DockPanel LastChildFill="False">
                <!-- Left: File Menu + Quick Icon Tool Buttons -->
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Menu Background="Transparent" VerticalAlignment="Center" Margin="0,0,8,0">
                        <MenuItem Header="{res:Text File}" FontWeight="SemiBold" Padding="8,4">
                            <MenuItem Header="{res:Text Open}" Command="{Binding OpenCommand}" InputGestureText="Ctrl+O">
                                <MenuItem.Icon><ui:SymbolIcon Symbol="FolderOpen20" /></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{res:Text OpenRecentFiles}">
                                <MenuItem.Icon><ui:SymbolIcon Symbol="History20" /></MenuItem.Icon>
                                <MenuItem.Resources>
                                    <CollectionViewSource x:Key="RecentFiles" Source="{Binding SaveData.RecentFiles}"/>
                                    <DataTemplate x:Key="StringOnlyTemplate">
                                        <TextBlock Text="{Binding}" />
                                    </DataTemplate>
                                </MenuItem.Resources>
                                <MenuItem.ItemsSource>
                                    <CompositeCollection>
                                        <CollectionContainer Collection="{Binding Source={StaticResource RecentFiles}}" />
                                        <Separator/>
                                        <MenuItem Header="{res:Text ClearRecentFilesHistory}" Command="{Binding ClearRecentFilesHistory}">
                                            <MenuItem.Icon><ui:SymbolIcon Symbol="Delete20" /></MenuItem.Icon>
                                        </MenuItem>
                                    </CompositeCollection>
                                </MenuItem.ItemsSource>
                                <MenuItem.ItemContainerStyle>
                                    <Style TargetType="{x:Type MenuItem}">
                                        <Setter Property="Command" Value="{Binding DataContext.OpenRecentFile, RelativeSource={RelativeSource AncestorType=Window}}" />
                                        <Setter Property="CommandParameter" Value="{Binding}" />
                                        <Setter Property="HeaderTemplate" Value="{StaticResource StringOnlyTemplate}" />
                                    </Style>
                                </MenuItem.ItemContainerStyle>
                            </MenuItem>
                            <MenuItem Header="{res:Text Save}" Command="{Binding SaveCommand}" InputGestureText="Ctrl+S">
                                <MenuItem.Icon><ui:SymbolIcon Symbol="Save20" /></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{res:Text SaveAs}" Command="{Binding SaveAsCommand}" InputGestureText="Ctrl+Shift+S">
                                <MenuItem.Icon><ui:SymbolIcon Symbol="SaveMultiple20" /></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{res:Text Reopen}" Command="{Binding ReopenCommand}" InputGestureText="Ctrl+R">
                                <MenuItem.Icon><ui:SymbolIcon Symbol="ArrowCounterclockwise20" /></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{res:Text AddFolder}" Command="{Binding AddFolderCommand}" InputGestureText="Ctrl+Shift+O">
                                <MenuItem.Icon><ui:SymbolIcon Symbol="FolderAdd20" /></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{res:Text Close}" Command="{Binding CloseCommand}" InputGestureText="Ctrl+W">
                                <MenuItem.Icon><ui:SymbolIcon Symbol="Dismiss20" /></MenuItem.Icon>
                            </MenuItem>
                            <Separator />
                            <MenuItem Header="{res:Text Quit}" Command="{Binding QuitCommand}" InputGestureText="Ctrl+Q">
                                <MenuItem.Icon><ui:SymbolIcon Symbol="SignOut20" /></MenuItem.Icon>
                            </MenuItem>
                        </MenuItem>

                        <MenuItem Header="{res:Text Tag}" Click="Tag_Click" FontWeight="SemiBold" Padding="8,4">
                            <MenuItem>
                                <MenuItem.Header>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="10" Height="10" Fill="Black" Margin="0,0,8,0"/>
                                        <TextBlock Text="默认 (黑色)" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </MenuItem.Header>
                            </MenuItem>
                            <MenuItem>
                                <MenuItem.Header>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="10" Height="10" Fill="#E81123" Margin="0,0,8,0"/>
                                        <TextBlock Text="红色 (危险/BOSS)" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </MenuItem.Header>
                            </MenuItem>
                            <MenuItem>
                                <MenuItem.Header>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="10" Height="10" Fill="#107C41" Margin="0,0,8,0"/>
                                        <TextBlock Text="绿色 (安全/触发区)" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </MenuItem.Header>
                            </MenuItem>
                            <MenuItem>
                                <MenuItem.Header>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="10" Height="10" Fill="#0078D4" Margin="0,0,8,0"/>
                                        <TextBlock Text="蓝色 (普通敌人)" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </MenuItem.Header>
                            </MenuItem>
                            <MenuItem>
                                <MenuItem.Header>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="10" Height="10" Fill="#FFB900" Margin="0,0,8,0"/>
                                        <TextBlock Text="黄色 (宝箱/掉落物)" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </MenuItem.Header>
                            </MenuItem>
                            <MenuItem>
                                <MenuItem.Header>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="10" Height="10" Fill="#D83B01" Margin="0,0,8,0"/>
                                        <TextBlock Text="橙色 (机关/门锁)" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </MenuItem.Header>
                            </MenuItem>
                            <MenuItem>
                                <MenuItem.Header>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="10" Height="10" Fill="#8764B8" Margin="0,0,8,0"/>
                                        <TextBlock Text="紫色 (动态生成)" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </MenuItem.Header>
                            </MenuItem>
                        </MenuItem>

                        <MenuItem Header="{res:Text Help}" FontWeight="SemiBold" Padding="8,4">
                            <MenuItem Header="{res:Text About}" Command="{Binding OpenAbout}">
                                <MenuItem.Icon><ui:SymbolIcon Symbol="Info20" /></MenuItem.Icon>
                            </MenuItem>
                        </MenuItem>
                    </Menu>

                    <!-- Quick Icon Buttons -->
                    <ui:Button Icon="{ui:SymbolIcon FolderOpen20}"
                               Command="{Binding OpenCommand}"
                               ToolTip="打开文件 (Ctrl+O)"
                               Appearance="Secondary"
                               Margin="0,0,4,0" Padding="8,5" />
                    <ui:Button Icon="{ui:SymbolIcon Save20}"
                               Command="{Binding SaveCommand}"
                               ToolTip="保存修改 (Ctrl+S)"
                               Appearance="Secondary"
                               Margin="0,0,4,0" Padding="8,5" />
                    <ui:Button Icon="{ui:SymbolIcon ArrowCounterclockwise20}"
                               Command="{Binding ReopenCommand}"
                               ToolTip="重新读取 (Ctrl+R)"
                               Appearance="Secondary"
                               Margin="0,0,8,0" Padding="8,5" />

                    <Rectangle Width="1" Height="22" Fill="{DynamicResource ControlStrokeColorDefaultBrush}" Margin="2,0,8,0"/>

                    <!-- Toggle Sidebar Button -->
                    <ui:Button Icon="{ui:SymbolIcon PanelLeft20}"
                               Content="{res:Text HSideBar}"
                               Click="SideColumn_Hide"
                               Appearance="Secondary"
                               Margin="0,0,8,0" Padding="10,5" />

                    <!-- UVAR Mode Switch Button -->
                    <ui:Button Icon="{ui:SymbolIcon Tag20}"
                               Content="{Binding UvarToggleText}"
                               Command="{Binding ToggleUvar}"
                               Appearance="Primary"
                               Margin="0,0,6,0" Padding="12,5" />

                    <!-- UVAR Settings Button -->
                    <ui:Button Icon="{ui:SymbolIcon Settings20}"
                               Content="UVAR 文件配置"
                               Command="{Binding OpenSettings}"
                               Appearance="Secondary"
                               Margin="0,0,8,0" Padding="10,5" />
                </StackPanel>

                <!-- Right: Game Version & Theme Dropdowns -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="Games20" Margin="0,0,6,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <TextBlock Text="游戏:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <ComboBox ItemsSource="{x:Static rsztool:RszDefines.GameNames}"
                              SelectedValue="{Binding SaveData.GameName}"
                              Width="110" Margin="0,0,14,0" VerticalAlignment="Center"/>

                    <ui:SymbolIcon Symbol="TextFont20" Margin="0,0,6,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <TextBlock Text="字号:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <ComboBox ItemsSource="{x:Static viewmodels:MainWindowModel.FontSizeOptions}"
                              SelectedValue="{Binding AppFontSize, Mode=TwoWay}"
                              SelectedValuePath="Size"
                              DisplayMemberPath="Label"
                              Width="95" Margin="0,0,14,0" VerticalAlignment="Center"/>

                    <ui:SymbolIcon Symbol="Color20" Margin="0,0,6,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <TextBlock Text="主题:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <ComboBox ItemsSource="{x:Static rsztool:RszDefines.Themes}"
                              SelectedValue="{Binding SaveData.CurTheme, Mode=TwoWay}"
                              Width="105" VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main Work Area (Explorer, Tab Workspace & UVAR Hub) -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0" x:Name="col1" />
                <ColumnDefinition Width="Auto" x:Name="col2" />
                <ColumnDefinition Width="*" x:Name="col3" />
            </Grid.ColumnDefinitions>

            <!-- File Explorer Sidebar -->
            <Border Grid.Column="0"
                    Background="{DynamicResource LayerFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="0,0,1,0">
                <views:FileExplorerTree DataContext="{Binding FileExplorerViewModel}" Margin="4" />
            </Border>

            <!-- Splitter with modern hover feedback -->
            <GridSplitter Grid.Column="1" Width="5"
                          HorizontalAlignment="Center"
                          Background="Transparent"
                          Cursor="SizeWE" />

            <!-- Normal Mode (TabablzControl File Workspace) -->
            <Grid Grid.Column="2">
                <Grid.RenderTransform>
                    <TranslateTransform Y="0"/>
                </Grid.RenderTransform>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsUvarMode}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <dragablz:TabablzControl Style="{StaticResource TabablzControlStyle}"
                                         FontSize="{Binding AppFontSize, FallbackValue=13}">
                    <dragablz:TabablzControl.InterTabController>
                        <dragablz:InterTabController InterTabClient="{Binding InterTabClient}" />
                    </dragablz:TabablzControl.InterTabController>
                </dragablz:TabablzControl>

                <!-- Empty State Hint with modern Fluent graphics -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            Style="{StaticResource UsageHint}">
                    <Border Width="80" Height="80" CornerRadius="40"
                            Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                            Margin="0,0,0,16" HorizontalAlignment="Center">
                        <ui:SymbolIcon Symbol="DocumentLandscape24" FontSize="40"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="{res:Text UsageHint}"
                               TextAlignment="Center"
                               FontWeight="SemiBold"
                               FontSize="16"
                               Foreground="{DynamicResource TextForeground}"/>
                    <TextBlock Text="请从菜单【文件 -> 打开】或直接将 .scn / .pfb / .user 文件拖拽至此窗口"
                               TextAlignment="Center"
                               FontSize="13"
                               Margin="0,6,0,0"
                               Foreground="{DynamicResource TextForeground}"
                               Opacity="0.75"/>
                </StackPanel>
            </Grid>

            <!-- UVAR Mode Workspace -->
            <DockPanel Grid.Column="2" Margin="8">
                <DockPanel.RenderTransform>
                    <TranslateTransform Y="0"/>
                </DockPanel.RenderTransform>
                <DockPanel.Style>
                    <Style TargetType="DockPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsUvarMode}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                             From="0.1" To="1.0" Duration="0:0:0.2">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                             From="8" To="0" Duration="0:0:0.2">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DockPanel.Style>

                <Border DockPanel.Dock="Top"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12,8"
                        Margin="0,0,0,8">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <ui:Button Icon="{ui:SymbolIcon Save20}" Content="保存 UVAR"
                                       Command="{Binding SaveCommand}" Appearance="Primary" Margin="4,0" Padding="12,6"/>
                            <ui:Button Icon="{ui:SymbolIcon SaveMultiple20}" Content="另存为"
                                       Command="{Binding SaveAsCommand}" Appearance="Secondary" Margin="4,0" Padding="10,6"/>
                            <ui:Button Icon="{ui:SymbolIcon ArrowCounterclockwise20}" Content="重新读取"
                                       Command="{Binding ReopenCommand}" Appearance="Secondary" Margin="4,0" Padding="10,6"/>
                            <ui:Button Icon="{ui:SymbolIcon ArrowReply20}" Content="返回文件编辑"
                                       Command="{Binding ToggleUvar}" Appearance="Secondary" Margin="4,0" Padding="10,6"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Tag20" Margin="0,0,8,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Text="{Binding UvarWorkspace.DocumentTitle}" Foreground="{DynamicResource TextForeground}"
                                       FontWeight="SemiBold"
                                       FontSize="14"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding UvarWorkspace.DocumentTitle}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <views:UvarFileView DataContext="{Binding UvarWorkspace.Current}"/>
            </DockPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>