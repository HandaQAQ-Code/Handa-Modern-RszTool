<ui:FluentWindow x:Class="RszTool.App.Views.FileAssociationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        Title="文件格式关联与右键菜单设置"
        Width="680" Height="580" MinWidth="580" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TitleBar -->
        <ui:TitleBar Grid.Row="0" Title="文件格式关联与右键菜单设置" Padding="12,6"/>

        <!-- Main Content Area -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,10,20,10">
            <StackPanel>

                <!-- Header Banner Card -->
                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,0,0,14">
                    <DockPanel LastChildFill="True">
                        <Border DockPanel.Dock="Left" Width="42" Height="42" CornerRadius="8"
                                Background="{DynamicResource AccentFillColorDefaultBrush}"
                                VerticalAlignment="Center" Margin="0,0,14,0">
                            <ui:SymbolIcon Symbol="Attach24" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="RE Engine 游戏资源扩展名绑定" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Text="绑定后，Windows 资源管理器中双击相应文件将直接由 RszTool 打开。（配置仅写入当前用户注册表，无需管理员权限）"
                                       FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- File Extensions Association Card -->
                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="选择要绑定的文件扩展名" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,10"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>

                        <ItemsControl ItemsSource="{Binding Extensions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="8,8" Margin="0,2" CornerRadius="6"
                                            Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                        <DockPanel LastChildFill="True" VerticalAlignment="Center">
                                            <!-- Status Tag on Right -->
                                            <Border DockPanel.Dock="Right" CornerRadius="4" Padding="8,2" VerticalAlignment="Center"
                                                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                                                <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                            </Border>

                                            <!-- Checkbox and Description on Left -->
                                            <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,10,0">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Extension}" FontWeight="Bold" FontSize="13"
                                                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Width="55"/>
                                                    <TextBlock Text="{Binding Description}" FontSize="12" Margin="10,0,0,0"
                                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </CheckBox>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Explorer Context Menu Card -->
                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,0,0,14">
                    <DockPanel LastChildFill="True">
                        <!-- Status Tag on Right -->
                        <Border DockPanel.Dock="Right" CornerRadius="4" Padding="8,2" VerticalAlignment="Center"
                                Background="{DynamicResource ControlFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                            <TextBlock Text="{Binding ContextMenuStatusText}" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </Border>

                        <!-- Context Menu Checkbox -->
                        <CheckBox IsChecked="{Binding IsContextMenuSelected}" VerticalAlignment="Center">
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="在 Windows 资源管理器右键菜单中添加 “用 RszTool 打开”"
                                           FontWeight="SemiBold" FontSize="13"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                <TextBlock Text="强烈推荐勾选！对于带有 .20, .2 等多重版本后缀的文件（如 scene.scn.20, items.user.2），右键即可一键直接打开。"
                                           FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                            </StackPanel>
                        </CheckBox>
                    </DockPanel>
                </Border>

                <!-- Current Executable Path Info -->
                <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="6" Padding="12,8">
                    <DockPanel>
                        <ui:SymbolIcon Symbol="Folder20" DockPanel.Dock="Left" Margin="0,0,8,0"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="程序路径: " FontWeight="SemiBold" FontSize="11"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding ExecutablePath}" FontSize="11" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Bottom Action Bar -->
        <Border Grid.Row="2" Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0"
                Padding="18,12">
            <DockPanel LastChildFill="False">
                <ui:Button DockPanel.Dock="Left" Content="清除全部关联"
                           Appearance="Secondary" Padding="14,6" Click="UnregisterAll_Click"/>

                <ui:Button DockPanel.Dock="Right" Content="关闭"
                           Appearance="Secondary" Padding="16,6" Margin="8,0,0,0" IsCancel="True"/>

                <ui:Button DockPanel.Dock="Right" Content="一键应用绑定"
                           Appearance="Primary" Padding="20,6" Click="Apply_Click" IsDefault="True"/>
            </DockPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
