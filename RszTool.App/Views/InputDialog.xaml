<ui:FluentWindow x:Class="RszTool.App.Views.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="输入"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="Height"
        Width="380" FontSize="13">
    <Grid Margin="0,0,0,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="输入" ShowMaximize="False" ShowMinimize="False" Padding="12,6"/>
        <TextBlock Text="{Binding Message, RelativeSource={RelativeSource AncestorType=Window}}"
                   Margin="24,12,24,6" TextAlignment="Center" Grid.Row="1" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
        <TextBox x:Name="InputBox" Text="{Binding InputText, RelativeSource={RelativeSource AncestorType=Window}}"
                 Margin="24,6,24,16" Grid.Row="2"
                 PreviewKeyDown="OnTextBoxPreviewKeyDown" />
        <StackPanel Orientation="Horizontal" Grid.Row="3" HorizontalAlignment="Right" Margin="0,0,24,0">
            <ui:Button Content="确定" Appearance="Primary" Width="80" Margin="4,0" Click="OKButton_Click" IsDefault="True"/>
            <ui:Button Content="取消" Appearance="Secondary" Width="80" Margin="4,0" Click="CancelButton_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
