<ui:FluentWindow x:Class="RszTool.App.Views.TransformBatchEditWindow"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:RszTool.App.ViewModels"
        mc:Ignorable="d"
        Title="Batch via.Transform v0" Height="320" Width="560"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <ObjectDataProvider x:Key="TransformBatchEditModes"
                            MethodName="GetValues"
                            ObjectType="{x:Type sys:Enum}"
                            xmlns:sys="clr-namespace:System;assembly=mscorlib">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="viewmodels:TransformBatchEditMode" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </Window.Resources>
    <Grid>
    <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <ui:TitleBar Grid.Row="0" Title="Batch via.Transform v0 批量变换" Padding="10,4"/>
    <Grid Grid.Row="1" Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="{Binding SelectedGameObjectCount, StringFormat=Selected GameObjects: {0}}"
                   Margin="0 0 0 10" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="70" />
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="160" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="Axis" FontWeight="Bold" Grid.Row="0" Grid.Column="0" />
            <TextBlock Text="Enable" FontWeight="Bold" Grid.Row="0" Grid.Column="1" />
            <TextBlock Text="Mode" FontWeight="Bold" Grid.Row="0" Grid.Column="2" />
            <TextBlock Text="Value / Step" FontWeight="Bold" Grid.Row="0" Grid.Column="3" />

            <TextBlock Text="X" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0 8 0 0" />
            <CheckBox IsChecked="{Binding X.Enabled}" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Margin="0 8 0 0" />
            <ComboBox ItemsSource="{Binding Source={StaticResource TransformBatchEditModes}}" SelectedItem="{Binding X.Mode}"
                      Grid.Row="1" Grid.Column="2" Margin="0 8 8 0" />
            <TextBox Text="{Binding X.Value}" Grid.Row="1" Grid.Column="3" Margin="0 8 0 0" />

            <TextBlock Text="Y" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Margin="0 8 0 0" />
            <CheckBox IsChecked="{Binding Y.Enabled}" Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" Margin="0 8 0 0" />
            <ComboBox ItemsSource="{Binding Source={StaticResource TransformBatchEditModes}}" SelectedItem="{Binding Y.Mode}"
                      Grid.Row="2" Grid.Column="2" Margin="0 8 8 0" />
            <TextBox Text="{Binding Y.Value}" Grid.Row="2" Grid.Column="3" Margin="0 8 0 0" />

            <TextBlock Text="Z" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Margin="0 8 0 0" />
            <CheckBox IsChecked="{Binding Z.Enabled}" Grid.Row="3" Grid.Column="1" VerticalAlignment="Center" Margin="0 8 0 0" />
            <ComboBox ItemsSource="{Binding Source={StaticResource TransformBatchEditModes}}" SelectedItem="{Binding Z.Mode}"
                      Grid.Row="3" Grid.Column="2" Margin="0 8 8 0" />
            <TextBox Text="{Binding Z.Value}" Grid.Row="3" Grid.Column="3" Margin="0 8 0 0" />

            <TextBlock Text="J" Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Margin="0 8 0 0" />
            <CheckBox IsChecked="{Binding J.Enabled}" Grid.Row="4" Grid.Column="1" VerticalAlignment="Center" Margin="0 8 0 0" />
            <ComboBox ItemsSource="{Binding Source={StaticResource TransformBatchEditModes}}" SelectedItem="{Binding J.Mode}"
                      Grid.Row="4" Grid.Column="2" Margin="0 8 8 0" />
            <TextBox Text="{Binding J.Value}" Grid.Row="4" Grid.Column="3" Margin="0 8 0 0" />
        </Grid>

        <StackPanel Orientation="Horizontal" Grid.Row="2" HorizontalAlignment="Right" Margin="0 12 0 0">
            <ui:Button Content="OK" Width="72" Margin="5" Click="OKButton_Click" />
            <ui:Button Content="Cancel" Width="72" Margin="5" Click="CancelButton_Click" />
        </StackPanel>
    </Grid>
</Grid>
</ui:FluentWindow>
