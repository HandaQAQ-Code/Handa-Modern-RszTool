<ui:FluentWindow x:Class="RszTool.App.Views.UvarGuidPickerWindow"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="从 UVAR 选择 GUID" Width="1180" Height="720" MinWidth="780" MinHeight="450" WindowStartupLocation="CenterOwner">
    <Grid>
    <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <ui:TitleBar Grid.Row="0" Title="从 UVAR 库选取 GUID 触发器" Padding="10,4"/>
    <DockPanel Grid.Row="1" Margin="14">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="{Binding FilePath}" TextWrapping="Wrap" Margin="0,0,0,8"/>
            <TextBlock Text="双击 flag 或点击“使用此 GUID”填入当前字段。下次会回到上次选择的位置。" Margin="0,0,0,10"/>
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions>
                <ComboBox ItemsSource="{Binding Groups}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedGroup}" Margin="0,0,8,0"/>
                <TextBox Grid.Column="1" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" ToolTip="搜索 flag 名称、GUID、分组或备注" Margin="0,0,8,0"/>
                <CheckBox Grid.Column="2" Content="仅显示未使用" IsChecked="{Binding UnusedOnly}" VerticalAlignment="Center"/>
            </Grid>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <TextBlock Text="{Binding SelectedFlag.Name}" FontWeight="Bold"/>
            <TextBlock Text="{Binding SelectedFlag.Id}" Margin="0,4,0,8"/>
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <ui:Button Content="使用此 GUID" Width="120" Margin="4" IsDefault="True" Click="Choose_Click"/>
                    <ui:Button Content="取消" Width="80" Margin="4" IsCancel="True"/>
                </StackPanel>
                <CheckBox x:Name="MarkUsedInput" Content="选用后标记为已使用" IsChecked="True" VerticalAlignment="Center"/>
            </DockPanel>
        </StackPanel>
        <DataGrid x:Name="FlagGrid" ItemsSource="{Binding Flags}" SelectedItem="{Binding SelectedFlag, Mode=TwoWay}"
                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                  SelectionMode="Single" SelectionUnit="FullRow" EnableRowVirtualization="True" MouseDoubleClick="Grid_DoubleClick">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}"><Style.Triggers><DataTrigger Binding="{Binding Used}" Value="True"><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{DynamicResource AccentFillColorDefaultBrush}"/></DataTrigger></Style.Triggers></Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="已使用" Binding="{Binding Used}" Width="65"/>
                <DataGridTextColumn Header="Flag 名称" Binding="{Binding Name}" Width="250"/>
                <DataGridTextColumn Header="使用备注" Binding="{Binding Note}" Width="200"/>
                <DataGridTextColumn Header="分组" Binding="{Binding GroupPath}" Width="*"/>
                <DataGridTextColumn Header="GUID" Binding="{Binding Id}" Width="275"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Grid>
</ui:FluentWindow>
