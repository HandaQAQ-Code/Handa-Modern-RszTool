<ui:FluentWindow x:Class="RszTool.App.Views.UvarSettingsWindow"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置 · UVAR 文件" Width="820" Height="290" MinWidth="620" ResizeMode="CanResizeWithGrip" WindowStartupLocation="CenterOwner">
    <Grid>
    <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <ui:TitleBar Grid.Row="0" Title="配置全局 UVAR / Flag 文件" Padding="10,4"/>
    <Grid Grid.Row="1" Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="用于 flag 管理和 USER 文件 System.GUID 选择的 uvar.3 文件" Margin="0,0,0,12"/>
        <DockPanel Grid.Row="1">
            <ui:Button Content="浏览…" DockPanel.Dock="Right" Width="80" Click="Browse_Click"/>
            <TextBox x:Name="PathInput" Margin="0,0,10,0" VerticalContentAlignment="Center"/>
        </DockPanel>
        <TextBlock Grid.Row="2" Text="设置后，通过主窗口的“UVAR / Flag 管理”按钮切换。GUID 选择器会记住该文件上次的分组、搜索条件与选中位置。" TextWrapping="Wrap" Margin="0,15,0,12"/>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <ui:Button Content="保存设置" Width="110" Margin="4" Click="Save_Click" IsDefault="True"/>
            <ui:Button Content="取消" Width="80" Margin="4" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Grid>
</ui:FluentWindow>
