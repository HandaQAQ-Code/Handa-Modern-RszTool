<ui:FluentWindow x:Class="RszTool.App.Views.TransformPointsJsonWindow"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Import Transform Points JSON" Height="560" Width="860"
        MinHeight="360" MinWidth="620"
        WindowStartupLocation="CenterOwner">
    <Grid>
    <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <ui:TitleBar Grid.Row="0" Title="导入 Transform Points JSON 坐标数据" Padding="10,4"/>
    <Grid Grid.Row="1" Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Text="{Binding JsonPath, UpdateSourceTrigger=PropertyChanged}"
                     VerticalContentAlignment="Center"
                     ToolTip="JSON file path" />
            <ui:Button Grid.Column="1" Content="Browse..." Width="84" Margin="8,0,0,0"
                    Click="BrowseButton_Click" />
            <ui:Button Grid.Column="2" Content="Load" Width="72" Margin="8,0,0,0"
                    Click="LoadButton_Click" />
        </Grid>

        <Grid Grid.Row="1" Margin="0,10,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Group:" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox Grid.Column="1"
                      ItemsSource="{Binding Groups}"
                      SelectedItem="{Binding SelectedGroup}"
                      DisplayMemberPath="Name"
                      MinWidth="220" />
        </Grid>

        <ListBox x:Name="PointList"
                 Grid.Row="2"
                 ItemsSource="{Binding Points}"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 MouseDoubleClick="PointList_MouseDoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Display}" FontFamily="Consolas" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" TextWrapping="Wrap" />
            <ui:Button Grid.Column="1" Content="Cancel" Width="72" Margin="8,0,0,0"
                    Click="CancelButton_Click" />
        </Grid>
    </Grid>
</Grid>
</ui:FluentWindow>
