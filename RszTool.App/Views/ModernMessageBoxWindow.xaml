<ui:FluentWindow x:Class="RszTool.App.Views.ModernMessageBoxWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="通知"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="Height"
        Width="480"
        MinWidth="380"
        MaxWidth="680"
        FontSize="13">

    <Grid Margin="0,0,0,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Modern Fluent TitleBar -->
        <ui:TitleBar x:Name="TitleBarControl" Grid.Row="0" Title="提示"
                     ShowMaximize="False" ShowMinimize="False" Padding="12,6"/>

        <!-- Dialog Content Body -->
        <Border Grid.Row="1" Margin="20,10,20,16"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Icon -->
                <ui:SymbolIcon x:Name="DialogIcon" Symbol="Info28" FontSize="30"
                               Margin="0,2,16,0" VerticalAlignment="Top"/>

                <!-- Message Text -->
                <ScrollViewer Grid.Column="1" MaxHeight="320" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <TextBlock x:Name="MessageText"
                               TextWrapping="Wrap"
                               LineHeight="20"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               VerticalAlignment="Center"/>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Dialog Actions Button Bar -->
        <StackPanel x:Name="ButtonPanel" Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,0,20,0">
            <ui:Button x:Name="BtnYes" Content="是" Appearance="Primary" Width="85" Margin="4,0" Click="BtnYes_Click"/>
            <ui:Button x:Name="BtnOk" Content="确定" Appearance="Primary" Width="85" Margin="4,0" Click="BtnOk_Click"/>
            <ui:Button x:Name="BtnNo" Content="否" Appearance="Secondary" Width="85" Margin="4,0" Click="BtnNo_Click"/>
            <ui:Button x:Name="BtnCancel" Content="取消" Appearance="Secondary" Width="85" Margin="4,0" Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
