<ui:FluentWindow x:Class="RszTool.App.Views.DuplicateMontageIdWindow"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="复制敌人 · MontageID 随机化" Width="1030" Height="730" MinWidth="820" MinHeight="550" WindowStartupLocation="CenterOwner">
 <Grid>
    <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <ui:TitleBar Grid.Row="0" Title="复制并随机分配敌人 MontageID 动作姿态" Padding="10,4"/>
    <Grid Grid.Row="1" Margin="14">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel>
   <CheckBox x:Name="RandomizeInput" Content="随机化新副本的 MontageID" IsChecked="True" FontWeight="Bold" Margin="0,0,0,8"/>
   <TextBlock Text="默认读取每个 MontageID 字段下拉框中的全部 ID。不同类型分别随机，不混用；可额外加入自定义 ID。" TextWrapping="Wrap"/>
  </StackPanel>
  <WrapPanel Grid.Row="1" Margin="0,12">
   <TextBlock Text="预设" VerticalAlignment="Center"/>
   <ComboBox x:Name="PresetPicker" IsEditable="True" DisplayMemberPath="Name" Width="245" Margin="8,0"/>
   <ui:Button Content="载入预设" Click="LoadPreset_Click" Padding="10,5" Margin="0,0,8,0"/>
   <ui:Button Content="保存 / 覆盖预设" Click="SavePreset_Click" Padding="10,5" Margin="0,0,8,0"/>
   <ui:Button Content="删除预设" Click="DeletePreset_Click" Padding="10,5" Margin="0,0,8,0"/>
   <ui:Button Content="恢复默认全部枚举" Click="Reset_Click" Padding="10,5"/>
  </WrapPanel>
  <Grid Grid.Row="2">
   <Grid.ColumnDefinitions><ColumnDefinition Width="310"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <ListBox x:Name="SourceList" DisplayMemberPath="Title" SelectionChanged="SourceList_SelectionChanged"/>
   <Grid x:Name="PoolEditor" Grid.Column="2">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="2*"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="{Binding Key}" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,8"/>
    <CheckBox Grid.Row="1" Content="包含该下拉框的所有 MontageID" IsChecked="{Binding IncludeEnumValues, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
    <DataGrid Grid.Row="2" ItemsSource="{Binding EnumItems}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False">
     <DataGrid.Columns><DataGridTextColumn Header="下拉框名称" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="MontageID" Binding="{Binding Value}" Width="160"/></DataGrid.Columns>
    </DataGrid>
    <TextBlock Grid.Row="3" Text="额外 ID（空格、换行或逗号分隔；支持 0x 十六进制）" Margin="0,10,0,5"/>
    <TextBox Grid.Row="4" Text="{Binding CustomIds, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
    <TextBlock Grid.Row="5" Text="{Binding Summary}" TextWrapping="Wrap" Margin="0,8,0,0"/>
   </Grid>
  </Grid>
  <StackPanel Grid.Row="3" Margin="0,12,0,0">
   <TextBlock x:Name="StatusText" TextWrapping="Wrap"/>
   <TextBlock Text="无枚举且未填写额外 ID 的字段保持原值。预设和最后配置会写入设置文件，重启后保留。" TextWrapping="Wrap" Margin="0,5,0,8"/>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><ui:Button Content="确定" Width="90" Margin="4" Click="OKButton_Click" IsDefault="True"/><ui:Button Content="取消" Width="90" Margin="4" IsCancel="True"/></StackPanel>
  </StackPanel>
 </Grid>
</Grid>
</ui:FluentWindow>
